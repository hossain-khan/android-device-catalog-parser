CREATE TABLE device (
  _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  brand TEXT NOT NULL,
  device TEXT NOT NULL,
  manufacturer TEXT NOT NULL,
  model_name TEXT NOT NULL,
  ram TEXT NOT NULL,
  form_factor TEXT NOT NULL,
  processor_name TEXT NOT NULL,
  gpu TEXT NOT NULL,
  min_sdk INTEGER NOT NULL,
  max_sdk INTEGER NOT NULL,
  ram_min_mb INTEGER NOT NULL,
  ram_max_mb INTEGER NOT NULL,
  sort_score INTEGER NOT NULL
);

CREATE INDEX index_device_manufacturer ON device (manufacturer);
CREATE INDEX index_device_model_name ON device (model_name);
CREATE INDEX index_device_brand ON device (brand);
CREATE INDEX index_device_form_factor ON device (form_factor);
CREATE INDEX index_device_min_sdk ON device (min_sdk);
CREATE INDEX index_device_max_sdk ON device (max_sdk);
CREATE INDEX index_device_ram_min_mb ON device (ram_min_mb);
CREATE INDEX index_device_ram_max_mb ON device (ram_max_mb);
CREATE INDEX index_device_sort_score ON device (sort_score DESC, manufacturer ASC, model_name ASC);

CREATE VIRTUAL TABLE device_fts USING fts4(
  manufacturer,
  model_name,
  brand,
  device,
  content="device"
);

CREATE TABLE device_abi (
  device_id INTEGER NOT NULL,
  abi TEXT NOT NULL,
  PRIMARY KEY (device_id, abi),
  FOREIGN KEY (device_id) REFERENCES device (_id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE INDEX index_device_abi_device_id ON device_abi (device_id);

CREATE TABLE device_opengl (
  device_id INTEGER NOT NULL,
  opengl_version TEXT NOT NULL,
  PRIMARY KEY (device_id, opengl_version),
  FOREIGN KEY (device_id) REFERENCES device (_id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE INDEX index_device_opengl_device_id ON device_opengl (device_id);

CREATE TABLE device_screen_density (
  device_id INTEGER NOT NULL,
  screen_density INTEGER NOT NULL,
  PRIMARY KEY (device_id, screen_density),
  FOREIGN KEY (device_id) REFERENCES device (_id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE INDEX index_device_screen_density_device_id ON device_screen_density (device_id);

CREATE TABLE device_screen_size (
  device_id INTEGER NOT NULL,
  screen_size TEXT NOT NULL,
  PRIMARY KEY (device_id, screen_size),
  FOREIGN KEY (device_id) REFERENCES device (_id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE INDEX index_device_screen_size_device_id ON device_screen_size (device_id);

CREATE TABLE device_sdk (
  device_id INTEGER NOT NULL,
  sdk_version INTEGER NOT NULL,
  PRIMARY KEY (device_id, sdk_version),
  FOREIGN KEY (device_id) REFERENCES device (_id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE INDEX index_device_sdk_device_id ON device_sdk (device_id);

selectAll:
SELECT *
FROM device;

selectBySortScore:
SELECT *
FROM device
ORDER BY sort_score DESC, manufacturer ASC, model_name ASC
LIMIT ? OFFSET ?;

searchFts:
SELECT device.*
FROM device
JOIN device_fts ON device._id = device_fts.rowid
WHERE device_fts MATCH ?
ORDER BY device.sort_score DESC, device.manufacturer ASC, device.model_name ASC;

lastInsertRowId:
SELECT last_insert_rowid();

insert:
INSERT INTO device(
  brand,
  device,
  manufacturer,
  model_name,
  ram,
  form_factor,
  processor_name,
  gpu,
  min_sdk,
  max_sdk,
  ram_min_mb,
  ram_max_mb,
  sort_score
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertAbi:
INSERT INTO device_abi(device_id, abi)
VALUES (?, ?);

getAbi:
SELECT *
FROM device_abi
WHERE device_id = ?;

insertOpenGlVersion:
INSERT INTO device_opengl(device_id, opengl_version)
VALUES (?, ?);

getOpenGlVersion:
SELECT *
FROM device_opengl
WHERE device_id = ?;

insertScreenDensity:
INSERT INTO device_screen_density(device_id, screen_density)
VALUES (?, ?);

getScreenDensity:
SELECT *
FROM device_screen_density
WHERE device_id = ?;

insertScreenSize:
INSERT INTO device_screen_size(device_id, screen_size)
VALUES (?, ?);

getScreenSize:
SELECT *
FROM device_screen_size
WHERE device_id = ?;

insertSdkVersion:
INSERT INTO device_sdk(device_id, sdk_version)
VALUES (?, ?);

getSdkVersion:
SELECT *
FROM device_sdk
WHERE device_id = ?;
